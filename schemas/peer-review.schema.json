{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solidify.local/schemas/peer-review.schema.json",
  "title": "Solidify Peer Review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_hash", "actor", "solid", "release_interpretation", "overall_confidence", "limitations"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "evidence_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "model_id", "provider"],
      "properties": {
        "role": {"type": "string", "enum": ["peer-a", "peer-b"]},
        "model_id": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "client": {"type": ["string", "null"]},
        "identity_source": {"type": ["string", "null"]}
      }
    },
    "solid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["S", "O", "L", "I", "D"],
      "properties": {
        "S": {"$ref": "#/$defs/principle"},
        "O": {"$ref": "#/$defs/principle"},
        "L": {"$ref": "#/$defs/principle"},
        "I": {"$ref": "#/$defs/principle"},
        "D": {"$ref": "#/$defs/principle"}
      }
    },
    "release_interpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "change_groups", "breaking_changes", "risks"],
      "properties": {
        "summary": {"type": "string"},
        "change_groups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "title", "evidence_refs"],
            "properties": {
              "type": {"type": "string", "enum": ["feature", "bugfix", "refactor", "performance", "security", "test", "docs", "build", "ci", "chore", "migration", "configuration", "breaking-change", "unknown"]},
              "title": {"type": "string"},
              "description": {"type": "string"},
              "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
            }
          }
        },
        "breaking_changes": {"type": "array", "items": {"type": "string"}},
        "risks": {"type": "array", "items": {"$ref": "#/$defs/risk"}}
      }
    },
    "overall_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "principle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicable", "before_score", "after_score", "confidence", "summary", "findings"],
      "properties": {
        "applicable": {"type": "boolean"},
        "before_score": {"$ref": "#/$defs/score"},
        "after_score": {"$ref": "#/$defs/score"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "summary": {"type": "string"},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}
      },
      "allOf": [
        {
          "if": {"properties": {"applicable": {"const": false}}},
          "then": {"properties": {"before_score": {"type": "null"}, "after_score": {"type": "null"}}}
        },
        {
          "if": {"properties": {"applicable": {"const": true}}},
          "then": {"properties": {"before_score": {"type": "number", "minimum": 0, "maximum": 100}, "after_score": {"type": "number", "minimum": 0, "maximum": 100}}}
        }
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "principle", "severity", "title", "evidence_refs", "rationale", "recommendation", "introduced_by_release"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "principle": {"type": "string", "enum": ["S", "O", "L", "I", "D"]},
        "severity": {"type": "string", "enum": ["info", "low", "medium", "high", "critical"]},
        "title": {"type": "string"},
        "file": {"type": ["string", "null"]},
        "line_start": {"type": ["integer", "null"], "minimum": 1},
        "line_end": {"type": ["integer", "null"], "minimum": 1},
        "evidence_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "rationale": {"type": "string", "minLength": 1},
        "recommendation": {"type": "string"},
        "introduced_by_release": {"type": "boolean"}
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "title", "evidence_refs"],
      "properties": {
        "severity": {"type": "string", "enum": ["low", "moderate", "high", "critical"]},
        "title": {"type": "string"},
        "description": {"type": "string"},
        "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  }
}
